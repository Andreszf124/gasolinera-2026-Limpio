@model IEnumerable<Gasolinera.Models.Entidades.MovimientoCashback>

@{
    ViewBag.Title = "Historial de Cashback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mt-4">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Historial de Cashback</h4>
    </div>

    <div class="card-body">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">No hay movimientos registrados para este cliente.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Puntos</th>
                            <th>Monto</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var movimiento in Model)
                        {
                            <tr>
                                <td>@movimiento.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @(movimiento.TipoMovimiento == Gasolinera.Common.TipoMovimientoCashback.Acumulacion ? "bg-success" : "bg-warning")">
                                        @movimiento.TipoMovimiento
                                    </span>
                                </td>
                                <td>@movimiento.PuntosGenerados.ToString("N0")</td>
                                <td>₡@movimiento.Monto.ToString("N2")</td>
                                <td>@movimiento.Observaciones</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-3">
            @Html.ActionLink("Volver", "Index", "Cashback", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>