@model Gasolinera.Models.Entidades.Categoria

@{
    ViewBag.Title = "Editar Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mt-4">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0">Editar Categoría</h4>
    </div>

    <div class="card-body">
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        }

        @using (Html.BeginForm("Editar", "Categorias", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CategoriaId)

            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 4 })
                @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3 form-check">
                @Html.CheckBoxFor(m => m.Activa, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.Activa, new { @class = "form-check-label" })
                <span class="text-muted ms-2">(Desmarcar para desactivar la categoría)</span>
            </div>

            <button type="submit" class="btn btn-success">Actualizar</button>
            @Html.ActionLink("Cancelar", "Index", "Categorias", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}