@model IEnumerable<Gasolinera.Models.Entidades.Categoria>

@{
    ViewBag.Title = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mt-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Categorías</h4>
        @if (User.IsInRole("Administrador") || User.IsInRole("Bodeguero"))
        {
            @Html.ActionLink("Nueva Categoría", "Crear", "Categorias", null, new { @class = "btn btn-light btn-sm" })
        }
    </div>

    <div class="card-body">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">No hay categorías registradas.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var categoria in Model)
                        {
                            <tr>
                                <td>@categoria.CategoriaId</td>
                                <td>@categoria.Nombre</td>
                                <td>@categoria.Descripcion</td>
                                <td>
                                    @if (categoria.Activa)
                                    {
                                        <span class="badge bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactiva</span>
                                    }
                                </td>
                                <td>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        @Html.ActionLink("Editar", "Editar", "Categorias", new { id = categoria.CategoriaId }, new { @class = "btn btn-warning btn-sm me-1" })
                                        @Html.ActionLink("Eliminar", "Eliminar", "Categorias", new { id = categoria.CategoriaId }, new { @class = "btn btn-danger btn-sm" })
                                    }
                                    else
                                    {
                                        <span class="text-muted">Solo lectura</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>