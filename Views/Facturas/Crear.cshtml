@{
    ViewBag.Title = "Nueva Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Realizar Compra</h4>
    </div>

    <div class="card-body">
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @using (Html.BeginForm("Crear", "Facturas", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Seleccione el Cliente</label>
                @Html.DropDownList("idCliente", (SelectList)ViewBag.Clientes, "-- Seleccione un cliente --", new { @class = "form-select", required = "required" })
            </div>

            <div class="mb-3">
                <label class="form-label">Productos</label>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Seleccionar</th>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in ViewBag.Productos)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="productoIds" value="@producto.IdProducto" class="producto-checkbox" />
                                    </td>
                                    <td>@producto.Nombre</td>
                                    <td>₡@producto.Precio.ToString("N2")</td>
                                    <td>@producto.Stock</td>
                                    <td>
                                        <input type="number" name="cantidades" class="form-control cantidad-input" style="width:80px;" min="1" max="@producto.Stock" value="1" disabled />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="alert alert-info">
                <strong>Total estimado:</strong> <span id="totalEstimado">₡0.00</span>
            </div>

            <button type="submit" class="btn btn-success">Realizar Compra</button>
            @Html.ActionLink("Volver", "Index", "Facturas", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {
            // Habilitar/deshabilitar cantidad según checkbox
            $('.producto-checkbox').on('change', function () {
                var cantidadInput = $(this).closest('tr').find('.cantidad-input');
                if ($(this).is(':checked')) {
                    cantidadInput.prop('disabled', false);
                } else {
                    cantidadInput.prop('disabled', true);
                    cantidadInput.val(1);
                }
                calcularTotal();
            });

            // Calcular total al cambiar cantidades
            $('.cantidad-input').on('input', function () {
                calcularTotal();
            });

            function calcularTotal() {
                var total = 0;
                $('.producto-checkbox:checked').each(function () {
                    var row = $(this).closest('tr');
                    var precio = parseFloat(row.find('td:eq(2)').text().replace('₡', '').replace(/,/g, ''));
                    var cantidad = parseInt(row.find('.cantidad-input').val()) || 0;
                    total += precio * cantidad;
                });
                $('#totalEstimado').text('₡' + total.toFixed(2));
            }
        });
    </script>
}