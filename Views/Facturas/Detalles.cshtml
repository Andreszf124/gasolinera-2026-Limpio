@model Gasolinera.Models.Entidades.Factura

@{
    ViewBag.Title = "Detalle de Factura";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-info text-white">
        <h4 class="mb-0">Detalle de Factura #@Model.IdFactura</h4>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th>Número de Factura</th>
                            <td>@Model.NumeroFactura</td>
                        </tr>
                        <tr>
                            <th>Fecha de Emisión</th>
                            <td>@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Venta</th>
                            <td>#@Model.IdVenta</td>
                        </tr>
                        <tr>
                            <th>Total</th>
                            <td><strong>₡@Model.Total.ToString("N2")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Información del Cliente</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Venta != null && Model.Venta.Cliente != null)
                        {
                            <p><strong>Nombre:</strong> @Model.Venta.Cliente.NombreCompleto</p>
                            <p><strong>Correo:</strong> @Model.Venta.Cliente.Correo</p>
                            <p><strong>Teléfono:</strong> @Model.Venta.Cliente.Telefono</p>
                        }
                        else
                        {
                            <p>No hay información del cliente disponible.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            @Html.ActionLink("Volver", "Index", "Facturas", null, new { @class = "btn btn-secondary" })
            @if (User.IsInRole("Administrador"))
            {
                @Html.ActionLink("Eliminar", "Eliminar", "Facturas", new { id = Model.IdFactura }, new { @class = "btn btn-danger" })
            }
        </div>
    </div>
</div>