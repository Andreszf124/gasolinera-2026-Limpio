@model IEnumerable<Gasolinera.Models.Entidades.Factura>

@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mt-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Facturas</h4>
        @if (User.IsInRole("Administrador") || User.IsInRole("Moderador"))
        {
            <span class="badge bg-light text-dark">Panel de administración</span>
        }
        else
        {
            <span class="badge bg-light text-dark">Mis compras</span>
        }
    </div>

    <div class="card-body">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @if (User.IsInRole("Administrador") || User.IsInRole("Moderador"))
        {
            <div class="mb-3">
                @Html.ActionLink("Nueva Factura (Compra)", "Crear", "Facturas", null, new { @class = "btn btn-primary" })
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">No hay facturas registradas.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Número</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var factura in Model)
                        {
                            <tr>
                                <td>@factura.IdFactura</td>
                                <td>@factura.NumeroFactura</td>
                                <td>@factura.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(factura.Venta?.Cliente?.NombreCompleto ?? "N/A")</td>
                                <td>₡@factura.Total.ToString("N2")</td>
                                <td>
                                    @if (factura.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                    else if (factura.Estado == "Aprobada")
                                    {
                                        <span class="badge bg-success">Aprobada</span>
                                    }
                                    else if (factura.Estado == "Rechazada")
                                    {
                                        <span class="badge bg-danger">Rechazada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@factura.Estado</span>
                                    }
                                </td>
                                <td>
                                    @Html.ActionLink("Detalle", "Detalles", "Facturas", new { id = factura.IdFactura }, new { @class = "btn btn-info btn-sm me-1" })

                                    @if (User.IsInRole("Administrador") || User.IsInRole("Moderador"))
                                    {
                                        if (factura.Estado == "Pendiente")
                                        {
                                            @Html.ActionLink("Aprobar", "Aprobar", "Facturas", new { id = factura.IdFactura }, new { @class = "btn btn-success btn-sm me-1" })
                                            @Html.ActionLink("Rechazar", "Rechazar", "Facturas", new { id = factura.IdFactura }, new { @class = "btn btn-danger btn-sm me-1" })
                                        }

                                        @Html.ActionLink("Eliminar", "Eliminar", "Facturas", new { id = factura.IdFactura }, new { @class = "btn btn-danger btn-sm" })
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>