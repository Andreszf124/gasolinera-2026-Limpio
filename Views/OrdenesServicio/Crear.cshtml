
@{
    ViewBag.Title = "Crear";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Crear</h2>

@using Gasolinera.Models.Entidades
@model OrdenServicio

@{
    ViewBag.Title = "Nueva orden de servicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Nueva orden de servicio</h4>
    </div>

    <div class="card-body">
        @using (Html.BeginForm("Crear", "OrdenesServicio", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid)
            {
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
            }

            <div class="mb-3">
                @Html.LabelFor(m => m.PlacaVehiculo, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.PlacaVehiculo, new { @class = "form-control", placeholder = "Ejemplo: ABC-123" })
                @Html.ValidationMessageFor(m => m.PlacaVehiculo, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.MarcaModelo, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.MarcaModelo, new { @class = "form-control", placeholder = "Ejemplo: Toyota Corolla" })
                @Html.ValidationMessageFor(m => m.MarcaModelo, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Anio, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Anio, new { @class = "form-control", type = "number", placeholder = "Ejemplo: 2020" })
                @Html.ValidationMessageFor(m => m.Anio, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Diagnostico, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Diagnostico, new { @class = "form-control", rows = 4, placeholder = "Describa el problema reportado..." })
                @Html.ValidationMessageFor(m => m.Diagnostico, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.TrabajosRealizados, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.TrabajosRealizados, new { @class = "form-control", rows = 3, placeholder = "Describa los trabajos realizados..." })
                @Html.ValidationMessageFor(m => m.TrabajosRealizados, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.CostoManoObra, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.CostoManoObra, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Ejemplo: 25000" })
                @Html.ValidationMessageFor(m => m.CostoManoObra, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.RepuestosUtilizadosResumen, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.RepuestosUtilizadosResumen, new { @class = "form-control", rows = 2, placeholder = "Ejemplo: Aceite, Filtro, Bujías..." })
                @Html.ValidationMessageFor(m => m.RepuestosUtilizadosResumen, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.IdCliente, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.IdCliente, new { @class = "form-control", type = "number", placeholder = "ID del cliente" })
                @Html.ValidationMessageFor(m => m.IdCliente, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.IdEmpleado, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.IdEmpleado, new { @class = "form-control", type = "number", placeholder = "ID del mecánico (opcional)" })
                @Html.ValidationMessageFor(m => m.IdEmpleado, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>

            @Html.ActionLink("Volver", "Index", "OrdenesServicio", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}