@using Gasolinera.Models.Entidades
@model OrdenServicio

@{
    ViewBag.Title = "Editar Orden de Servicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-warning">
        <h4 class="mb-0">Editar Orden de Servicio #@Model.IdOrdenServicio</h4>
    </div>

    <div class="card-body">
        @if (TempData["MensajeAdvertencia"] != null)
        {
            <div class="alert alert-warning">@TempData["MensajeAdvertencia"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        }

        @using (Html.BeginForm("Editar", "OrdenesServicio", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdOrdenServicio)

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.IdVehiculo, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.IdVehiculo, (SelectList)ViewBag.Vehiculos, "-- Seleccione un vehículo --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.IdVehiculo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.TipoServicio, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.TipoServicio, (SelectList)ViewBag.TiposServicio, "-- Seleccione un tipo --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.TipoServicio, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.DescripcionServicio, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.DescripcionServicio, new { @class = "form-control", rows = 4 })
                @Html.ValidationMessageFor(m => m.DescripcionServicio, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.NombreCliente, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.NombreCliente, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NombreCliente, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.IdEmpleado, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.IdEmpleado, (SelectList)ViewBag.Empleados, "-- Seleccione un mecánico --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.IdEmpleado, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.FechaEntrada, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.FechaEntrada, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                @Html.ValidationMessageFor(m => m.FechaEntrada, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Estado, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Estado, (SelectList)ViewBag.Estados, "-- Seleccione un estado --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-success">Actualizar</button>
            @Html.ActionLink("Volver", "Index", "OrdenesServicio", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}