@model Gasolinera.Models.Entidades.OrdenServicio

@{
    ViewBag.Title = "Cancelar Servicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card border-danger mt-4">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Cancelar Solicitud #@Model.IdOrdenServicio</h4>
    </div>

    <div class="card-body">
        <div class="alert alert-warning">
            <strong>¿Está seguro de que desea cancelar esta solicitud de servicio?</strong>
            <br />
            <span class="text-muted">Esta acción no se puede deshacer.</span>
        </div>

        <table class="table table-bordered">
            <tbody>
                <tr><th>Vehículo</th><td>@(Model.Vehiculo?.Placa ?? "N/A")</td></tr>
                <tr><th>Cliente</th><td>@Model.NombreCliente</td></tr>
                <tr><th>Tipo Servicio</th><td>@Model.TipoServicio</td></tr>
                <tr><th>Estado</th><td>@Model.Estado</td></tr>
                <tr><th>Fecha</th><td>@Model.FechaEntrada.ToString("dd/MM/yyyy HH:mm")</td></tr>
            </tbody>
        </table>

        @using (Html.BeginForm("Eliminar", "OrdenesServicio", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", Model.IdOrdenServicio)

            <button type="submit" class="btn btn-danger">Sí, cancelar</button>
            @Html.ActionLink("No, volver", "Index", "OrdenesServicio", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>