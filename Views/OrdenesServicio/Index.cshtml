@using System.Web.Mvc
@using System.Linq
@model IEnumerable<Gasolinera.Models.Entidades.OrdenServicio>

@{
    ViewBag.Title = "Mis Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">🔧 Mis Servicios</h4>
    </div>

    <div class="card-body">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @if (TempData["MensajeAdvertencia"] != null)
        {
            <div class="alert alert-warning">@TempData["MensajeAdvertencia"]</div>
        }

        @Html.ActionLink("Nueva Solicitud", "Crear", "OrdenesServicio", null, new { @class = "btn btn-primary mb-3" })
        @Html.ActionLink("Mis Vehículos", "Index", "Vehiculos", null, new { @class = "btn btn-secondary mb-3" })

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">No tiene solicitudes de servicio registradas.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Vehículo</th>
                            <th>Tipo Servicio</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var orden in Model)
                        {
                            <tr>
                                <td>@orden.IdOrdenServicio</td>
                                <td>@(orden.Vehiculo != null ? orden.Vehiculo.Placa : "N/A")</td>
                                <td>@orden.TipoServicio</td>
                                <td>
                                    <span class="badge @(orden.Estado == Gasolinera.Common.EstadoOrdenServicio.Pendiente ? "bg-warning" :
                                                       orden.Estado == Gasolinera.Common.EstadoOrdenServicio.EnProgreso ? "bg-info" :
                                                       orden.Estado == Gasolinera.Common.EstadoOrdenServicio.Completado ? "bg-success" :
                                                       orden.Estado == Gasolinera.Common.EstadoOrdenServicio.Cancelado ? "bg-danger" : "bg-secondary")">
                                        @orden.Estado
                                    </span>
                                </td>
                                <td>@orden.FechaEntrada.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @Html.ActionLink("Detalle", "Detalles", "OrdenesServicio", new { id = orden.IdOrdenServicio }, new { @class = "btn btn-info btn-sm me-1" })
                                    @if (orden.Estado == Gasolinera.Common.EstadoOrdenServicio.Pendiente)
                                    {
                                        @Html.ActionLink("Cancelar", "Eliminar", "OrdenesServicio", new { id = orden.IdOrdenServicio }, new { @class = "btn btn-danger btn-sm" })
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>