@using Gasolinera.Models.Entidades
@model Producto

@{
    ViewBag.Title = "Nuevo producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Nuevo producto</h4>
    </div>

    <div class="card-body">
        @using (Html.BeginForm("Crear", "Productos", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid)
            {
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
            }

            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ejemplo: Aceite de motor" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Precio, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Precio, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Ejemplo: 5000" })
                @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Stock, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number", placeholder = "Ejemplo: 10" })
                @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Categoria, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Categoria, (List<SelectListItem>)ViewBag.Categorias, "-- Seleccione una categoría --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>

            @Html.ActionLink("Volver", "Index", "Productos", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}