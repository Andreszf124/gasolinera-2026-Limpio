@using Gasolinera.Models.Entidades
@model Producto

@{
    ViewBag.Title = "Detalle del producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-info text-white">
        <h4 class="mb-0">Detalle del producto</h4>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>Nombre</th>
                    <td>@Model.Nombre</td>
                </tr>
                <tr>
                    <th>Precio</th>
                    <td>₡@Model.Precio.ToString("N2")</td>
                </tr>
                <tr>
                    <th>Stock disponible</th>
                    <td>@Model.Stock</td>
                </tr>
                <tr>
                    <th>Categoría</th>
                    <td>@Model.Categoria</td>
                </tr>
            </tbody>
        </table>

        @Html.ActionLink("Editar", "Editar", "Productos", new { id = Model.IdProducto }, new { @class = "btn btn-warning" })
        @Html.ActionLink("Volver", "Index", "Productos", null, new { @class = "btn btn-secondary" })
    </div>
</div>