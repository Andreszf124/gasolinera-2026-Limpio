@using Gasolinera.Models.Entidades
@model Producto

@{
    ViewBag.Title = "Editar producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-warning">
        <h4 class="mb-0">Editar producto</h4>
    </div>

    <div class="card-body">
        @using (Html.BeginForm("Editar", "Productos", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdProducto)

            if (!ViewData.ModelState.IsValid)
            {
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
            }

            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Precio, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Precio, new { @class = "form-control", type = "number", step = "0.01" })
                @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Stock, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number" })
                @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Categoria, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Categoria, (List<SelectListItem>)ViewBag.Categorias, "-- Seleccione una categoría --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-success">Actualizar</button>

            @Html.ActionLink("Volver", "Index", "Productos", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}