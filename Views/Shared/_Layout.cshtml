<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Gasolinera</title>
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/Site.css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("Gasolinera", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <!-- ========================================== -->
                    <!-- INICIO - Todos los usuarios               -->
                    <!-- ========================================== -->
                    <li class="nav-item">
                        @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })
                    </li>

                    <!-- ========================================== -->
                    <!-- DASHBOARD - Solo Administrador            -->
                    <!-- ========================================== -->
                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Dashboard", "Index", "Dashboard", null, new { @class = "nav-link" })
                        </li>
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        <!-- ========================================== -->
                        <!-- MI PERFIL - Todos los autenticados        -->
                        <!-- ========================================== -->
                        <li class="nav-item">
                            @Html.ActionLink("Mi Perfil", "Index", "Perfil", null, new { @class = "nav-link" })
                        </li>

                        <!-- ========================================== -->
                        <!-- TIENDA - Todos los autenticados          -->
                        <!-- ========================================== -->
                        <li class="nav-item">
                            @Html.ActionLink("Tienda", "Index", "Tienda", null, new { @class = "nav-link" })
                        </li>

                        <!-- ========================================== -->
                        <!-- SERVICIOS MECÁNICOS - Todos los autenticados -->
                        <!-- ========================================== -->
                        <li class="nav-item">
                            @Html.ActionLink("Servicios", "Index", "OrdenesServicio", null, new { @class = "nav-link" })
                        </li>

                        <!-- ========================================== -->
                        <!-- PRODUCTOS - Admin, Moderador, Bodeguero   -->
                        <!-- ========================================== -->
                        if (User.IsInRole("Administrador") || User.IsInRole("Moderador") || User.IsInRole("Bodeguero"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Productos", "Index", "Productos", null, new { @class = "nav-link" })
                            </li>
                        }

                        <!-- ========================================== -->
                        <!-- FACTURAS - Todos los autenticados         -->
                        <!-- ========================================== -->
                        <li class="nav-item">
                            @Html.ActionLink("Facturas", "Index", "Facturas", null, new { @class = "nav-link" })
                        </li>

                        <!-- ========================================== -->
                        <!-- VENTAS - Admin, Moderador, Bodeguero      -->
                        <!-- ========================================== -->
                        if (User.IsInRole("Administrador") || User.IsInRole("Moderador") || User.IsInRole("Bodeguero"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Ventas", "Index", "Ventas", null, new { @class = "nav-link" })
                            </li>
                        }

                        <!-- ========================================== -->
                        <!-- ORDENES SERVICIO - Admin, Moderador, Mecánico -->
                        <!-- ========================================== -->
                        if (User.IsInRole("Administrador") || User.IsInRole("Moderador") || User.IsInRole("Mecánico"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Orden Servicios", "Index", "OrdenesServicio", null, new { @class = "nav-link" })
                            </li>
                        }

                        <!-- ========================================== -->
                        <!-- CLIENTES - Admin, Moderador, Mecánico     -->
                        <!-- ========================================== -->
                        if (User.IsInRole("Administrador") || User.IsInRole("Moderador") || User.IsInRole("Mecánico"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Clientes", "Index", "Clientes", null, new { @class = "nav-link" })
                            </li>
                        }

                        <!-- ========================================== -->
                        <!-- CATEGORÍAS - Admin, Bodeguero             -->
                        <!-- ========================================== -->
                        if (User.IsInRole("Administrador") || User.IsInRole("Bodeguero"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Categorías", "Index", "Categorias", null, new { @class = "nav-link" })
                            </li>
                        }

                        <!-- ========================================== -->
                        <!-- CASHBACK, USUARIOS, AUDITORÍA - Solo Admin -->
                        <!-- ========================================== -->
                        if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Cashback", "Index", "Cashback", null, new { @class = "nav-link" })
                            </li>
                            <li class="nav-item">
                                @Html.ActionLink("Usuarios", "Index", "Usuarios", null, new { @class = "nav-link" })
                            </li>
                            <li class="nav-item">
                                @Html.ActionLink("Auditoría", "Index", "Auditoria", null, new { @class = "nav-link" })
                            </li>
                        }
                    }

                    <li class="nav-item">
                        @Html.ActionLink("About", "About", "Home", new { area = "" }, new { @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })
                    </li>
                </ul>

                <!-- ========================================== -->
                <!-- PARTE DERECHA - LOGIN / LOGOUT / USUARIO   -->
                <!-- ========================================== -->
                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="navbar-text text-white me-2">
                                <i class="bi bi-person-circle"></i> @User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            @using (Html.BeginForm("CerrarSesion", "Account", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">
                                    Cerrar Sesión
                                </button>
                            }
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Iniciar Sesión", "Login", "Account", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Registrarse", "Registro", "Account", null, new { @class = "nav-link" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Gasolinera</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>