@model Gasolinera.Models.Entidades.Vehiculo

@{
    ViewBag.Title = "Registrar Vehículo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Registrar Vehículo</h4>
    </div>

    <div class="card-body">
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        }

        @using (Html.BeginForm("Crear", "Vehiculos", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Placa, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Placa, new { @class = "form-control", placeholder = "Ejemplo: ABC123" })
                        @Html.ValidationMessageFor(m => m.Placa, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.TipoVehiculo, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.TipoVehiculo, (List<SelectListItem>)ViewBag.TiposVehiculo, "-- Seleccione un tipo --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.TipoVehiculo, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Marca, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Marca, new { @class = "form-control", placeholder = "Ejemplo: Toyota" })
                        @Html.ValidationMessageFor(m => m.Marca, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Modelo, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Modelo, new { @class = "form-control", placeholder = "Ejemplo: Corolla" })
                        @Html.ValidationMessageFor(m => m.Modelo, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Anio, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Anio, new { @class = "form-control", type = "number", placeholder = "Ejemplo: 2020" })
                        @Html.ValidationMessageFor(m => m.Anio, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Color, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Color, new { @class = "form-control", placeholder = "Ejemplo: Rojo" })
                        @Html.ValidationMessageFor(m => m.Color, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            @Html.ActionLink("Volver", "Index", "Vehiculos", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
