@model IEnumerable<Gasolinera.Models.Entidades.Vehiculo>

@{
    ViewBag.Title = "Mis Vehículos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mt-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Mis Vehículos</h4>
        @Html.ActionLink("Registrar Vehículo", "Crear", "Vehiculos", null, new { @class = "btn btn-light btn-sm" })
    </div>

    <div class="card-body">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">No tiene vehículos registrados.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Placa</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Año</th>
                            <th>Tipo</th>
                            <th>Color</th>
                            <th>Fecha de Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var vehiculo in Model)
                        {
                            <tr>
                                <td>@vehiculo.Placa</td>
                                <td>@vehiculo.Marca</td>
                                <td>@vehiculo.Modelo</td>
                                <td>@vehiculo.Anio</td>
                                <td>@vehiculo.TipoVehiculo</td>
                                <td>@(string.IsNullOrEmpty(vehiculo.Color) ? "No indicado" : vehiculo.Color)</td>
                                <td>@vehiculo.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @Html.ActionLink("Eliminar", "Eliminar", "Vehiculos", new { id = vehiculo.IdVehiculo }, new { @class = "btn btn-danger btn-sm" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @Html.ActionLink("Mis Servicios", "Index", "OrdenesServicio", null, new { @class = "btn btn-secondary" })
    </div>
</div>
