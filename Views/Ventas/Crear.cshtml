@using Gasolinera.Models.Entidades
@model Venta

@{
    ViewBag.Title = "Nueva Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Nueva Venta</h4>
    </div>

    <div class="card-body">
        @if (TempData["MensajeAdvertencia"] != null)
        {
            <div class="alert alert-warning">@TempData["MensajeAdvertencia"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        }

        @using (Html.BeginForm("Crear", "Ventas", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.Label("Cliente", new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.IdCliente, (List<SelectListItem>)ViewBag.Clientes, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.IdCliente, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.Label("Empleado", new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.IdEmpleado, (List<SelectListItem>)ViewBag.Empleados, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.IdEmpleado, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.TipoVenta, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.TipoVenta, new SelectList(new[] { "Combustible", "Productos" }), "-- Seleccione un tipo --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.TipoVenta, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.MetodoPago, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.MetodoPago, new SelectList(new[] { "Efectivo", "Tarjeta" }), "-- Seleccione un método --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.MetodoPago, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Subtotal, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Subtotal, new { @class = "form-control", type = "number", step = "0.01", placeholder = "0.00" })
                        @Html.ValidationMessageFor(m => m.Subtotal, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Descuento, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Descuento, new { @class = "form-control", type = "number", step = "0.01", placeholder = "0.00" })
                        @Html.ValidationMessageFor(m => m.Descuento, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Impuesto, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Impuesto, new { @class = "form-control", type = "number", step = "0.01", placeholder = "0.00" })
                        @Html.ValidationMessageFor(m => m.Impuesto, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="mb-3">
                @Html.Label("Orden de Servicio", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.IdOrdenServicio, (List<SelectListItem>)ViewBag.OrdenesServicio, new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.IdOrdenServicio, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            @Html.ActionLink("Volver", "Index", "Ventas", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}