@using Gasolinera.Models.Entidades
@model OrdenServicio

@{
    ViewBag.Title = "Editar Orden de Servicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4">
    <div class="card-header bg-warning">
        <h4 class="mb-0">Editar Orden de Servicio #@Model.IdOrdenServicio</h4>
    </div>

    <div class="card-body">
        @if (TempData["MensajeAdvertencia"] != null)
        {
            <div class="alert alert-warning">@TempData["MensajeAdvertencia"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        }

        @using (Html.BeginForm("Editar", "OrdenesServicio", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdOrdenServicio)

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.PlacaVehiculo, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.PlacaVehiculo, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.PlacaVehiculo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.MarcaModelo, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.MarcaModelo, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.MarcaModelo, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Anio, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Anio, new { @class = "form-control", type = "number" })
                        @Html.ValidationMessageFor(m => m.Anio, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.TipoVehiculo, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.TipoVehiculo, (List<SelectListItem>)ViewBag.TiposVehiculo, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.TipoVehiculo, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Diagnostico, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Diagnostico, new { @class = "form-control", rows = 4 })
                @Html.ValidationMessageFor(m => m.Diagnostico, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.TrabajosRealizados, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.TrabajosRealizados, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.TrabajosRealizados, "", new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CostoManoObra, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.CostoManoObra, new { @class = "form-control", type = "number", step = "0.01" })
                        @Html.ValidationMessageFor(m => m.CostoManoObra, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ListaRepuestosUtilizados, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.ListaRepuestosUtilizados, new { @class = "form-control", rows = 2 })
                        @Html.ValidationMessageFor(m => m.ListaRepuestosUtilizados, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.NombreCliente, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.NombreCliente, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.NombreCliente, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.IdEmpleado, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.IdEmpleado, (List<SelectListItem>)ViewBag.Empleados, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.IdEmpleado, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.FechaEntrada, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FechaEntrada, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        @Html.ValidationMessageFor(m => m.FechaEntrada, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Estado, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Estado, (List<SelectListItem>)ViewBag.Estados, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Actualizar</button>
            @Html.ActionLink("Volver", "Index", "OrdenesServicio", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}