@model IEnumerable<Gasolinera.Models.Entidades.Venta>

@{
    ViewBag.Title = "Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mt-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Ventas</h4>
        @Html.ActionLink("Nueva Venta", "Crear", "Ventas", null, new { @class = "btn btn-light btn-sm" })
    </div>

    <div class="card-body">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @if (TempData["MensajeAdvertencia"] != null)
        {
            <div class="alert alert-warning">@TempData["MensajeAdvertencia"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">No hay ventas registradas.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Tipo de Venta</th>
                            <th>Tipo de Pago</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var venta in Model)
                        {
                            <tr>
                                <td>@venta.IdVenta</td>
                                <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(venta.Cliente != null ? venta.Cliente.NombreCompleto : "N/A")</td>
                                <td>@venta.TipoVenta</td>
                                <td>@venta.TipoPago</td>
                                <td>₡@venta.Total.ToString("N2")</td>
                                <td>
                                    @if (venta.Estado == "Activa")
                                    {
                                        <span class="badge bg-success">@venta.Estado</span>
                                    }
                                    else if (venta.Estado == "Anulada")
                                    {
                                        <span class="badge bg-danger">@venta.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@venta.Estado</span>
                                    }
                                </td>
                                <td>
                                    @Html.ActionLink("Detalle", "Detalles", "Ventas", new { id = venta.IdVenta }, new { @class = "btn btn-info btn-sm me-1" })

                                    @if (User.IsInRole("Administrador") || User.IsInRole("Moderador"))
                                    {
                                        @Html.ActionLink("Editar", "Editar", "Ventas", new { id = venta.IdVenta }, new { @class = "btn btn-warning btn-sm me-1" })
                                        @Html.ActionLink("Eliminar", "Eliminar", "Ventas", new { id = venta.IdVenta }, new { @class = "btn btn-danger btn-sm" })
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
